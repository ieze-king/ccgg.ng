# ── Sanity CMS ────────────────────────────────────────────────────────
# From sanity.io/manage. Without these the site runs on its built-in
# content and /studio shows setup instructions instead of the editor.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── Form delivery (contact, parish registration, volunteer, partner) ──
# Without these, /api/enquiry returns 503 rather than losing submissions.
RESEND_API_KEY=
ENQUIRY_TO=
ENQUIRY_FROM="CCGG Website <onboarding@resend.dev>"
